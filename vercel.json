{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "X-Frame-Options",   "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy",   "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
